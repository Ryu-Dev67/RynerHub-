                    end
                end
            end
            return nil
        end

        local function cloneModel(model, parent)
            local prev = {}
            for _, d in ipairs(model:GetDescendants()) do
                prev[d] = d.Archivable
                pcall(function() d.Archivable = true end)
            end
            local selfArch = model.Archivable
            model.Archivable = true
            local ok, copy = pcall(function() return model:Clone() end)
            model.Archivable = selfArch
            for inst, v in pairs(prev) do
                pcall(function() inst.Archivable = v end)
            end
            if not ok or not copy then return nil end
            copy.Name = rname()
            for _, d in ipairs(copy:GetDescendants()) do
                if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ForceField")
                    or d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("WeldConstraint")
                    or d:IsA("BodyMover") or d:IsA("ProximityPrompt") or d:IsA("BillboardGui") then
                    pcall(function() d:Destroy() end)
                elseif d:IsA("BasePart") then
                    d.Anchored = true
                    d.CanCollide = false
                    d.CanQuery = false
                    d.CanTouch = false
                elseif d:IsA("Humanoid") then
                    d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                end
            end
            copy.Parent = parent
            return copy
        end

        local function disguiseOn(char, offset)
            local cam = Workspace.CurrentCamera
            if not char or not cam or S.Disguise then return end
            offset = offset or Vector3.zero
            local D = { Camera = cam, CameraType = cam.CameraType, CameraCFrame = cam.CFrame, Copies = {}, Hidden = {} }
            S.Disguise = D

            local sources = { char }
            local okM, eggModel = pcall(findCarryModel)
            if okM and eggModel then sources[#sources + 1] = eggModel end

            for _, src in ipairs(sources) do
                for _, d in ipairs(src:GetDescendants()) do
                    if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
                        D.Hidden[#D.Hidden + 1] = d
                    end
                end
            end

            local function freezeView()
                for _, p in ipairs(D.Hidden) do
                    pcall(function() p.LocalTransparencyModifier = 1 end)
                end
                pcall(function()
                    if cam.CameraType ~= Enum.CameraType.Scriptable then
                        cam.CameraType = Enum.CameraType.Scriptable
                    end
                    cam.CFrame = D.CameraCFrame
                end)
            end

            freezeView()
            D.BindName = rname()
            if not pcall(function()
                RunService:BindToRenderStep(D.BindName, Enum.RenderPriority.Last.Value + 1, freezeView)
            end) then
                D.BindName = nil
                D.Link = RunService.RenderStepped:Connect(freezeView)
            end
            D.Beat = RunService.Heartbeat:Connect(freezeView)

            for _, src in ipairs(sources) do
                local ok, copy = pcall(cloneModel, src, cam)
                if ok and copy then
                    if offset.Magnitude > 0.01 then
                        for _, d in ipairs(copy:GetDescendants()) do
                            if d:IsA("BasePart") then
                                pcall(function() d.CFrame = d.CFrame + offset end)
                            end
                        end
                    end
                    D.Copies[#D.Copies + 1] = copy
                end
            end
        end

        local function disguiseOff()
