        local function lineTarget(cfg, pos)
            local world = Workspace:FindFirstChild("World") or Workspace:FindFirstChild("__OBJECTS")
            local areas = world and world:FindFirstChild("Areas")
            local line = areas and areas:FindFirstChild("SeparationLine")
            if line and line:IsA("BasePart") then
                local cf = line.CFrame
                local perp = Vector3.new(0, 1, 0):Cross(line.Size.X >= line.Size.Z and cf.RightVector or cf.LookVector)
                local flat = Vector3.new(perp.X, 0, perp.Z)
                if flat.Magnitude > 0.001 then
                    local dir = flat.Unit
                    local side = ((pos - cf.Position):Dot(dir) >= 0) and -dir or dir
                    local p = cf.Position + side * (tonumber(cfg.LineOffset) or 8)
                    return Vector3.new(p.X, pos.Y + 0.5, p.Z)
                end
            end
            return nil
        end

