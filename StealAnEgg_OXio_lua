        local function expandTiming(cfg)
            local steps = type(cfg.Steps) == "table" and cfg.Steps or {}
            local releaseAt = tonumber(cfg.ReleaseAt) or 0
            local startAt = math.max(tonumber(cfg.StartAt) or 0, 0)
            local startRand = math.max(tonumber(cfg.StartRandom) or 0, 0)
            local hopRand = math.max(tonumber(cfg.HopRandom) or 0, 0)
            local holdRand = math.max(tonumber(cfg.HoldRandom) or 0, 0)
            if startRand <= 0 and hopRand <= 0 and holdRand <= 0 then
                return steps, releaseAt, startAt
            end
            local t0 = math.max(startAt + rand(startRand), 0)
            local out = {}
            local t, prevAt = 0, 0
            for i, step in ipairs(steps) do
                if type(step) ~= "table" then break end
                local at = math.max(tonumber(step.At) or 0, 0)
                t = math.max(t + math.max(at - prevAt, 0) + rand(step.To == "start" and holdRand or hopRand), t0)
                out[i] = { At = t, To = step.To, Glide = step.Glide }
                prevAt = at
            end
            return out, t + math.max(releaseAt - prevAt, 0), t0
        end

        local function runDodge(startedAt)
            local char = LP.Character
            local hrp = findHRP()
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                finish()
                flash(C.Bad, 1.6)
                return
            end

            local function ok()
                return alive and hrp.Parent ~= nil and hum.Parent ~= nil and hum.Health > 0
            end

            local oldPlatform = hum.PlatformStand
            local startCF = hrp.CFrame
            local startVec = startCF.Position
            local cfg = getCfg()
            local steps, releaseAt, startAt = expandTiming(cfg)
            local freeze = cfg.Freeze ~= false
            local facing = tostring(cfg.Facing or "Keep")
            local jitter = math.max(tonumber(cfg.Jitter) or 0, 0)
            local baseRot = (facing == "Zero") and CFrame.new() or startCF.Rotation

            local function rotation()
                if facing == "Spin" then
                    return CFrame.Angles(0, math.rad(math.random(0, 359)), 0)
                end
                return baseRot
            end

            local function jit(p)
                if jitter <= 0 then return p end
                return p + Vector3.new((math.random() * 2 - 1) * jitter, 0, (math.random() * 2 - 1) * jitter)
            end

            local home = targetFor(cfg, startVec)

            local function waitUntil(t)
                while ok() and os.clock() - startedAt < t do
                    RunService.Heartbeat:Wait()
                    if freeze then
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                end
                return ok()
            end

            local function hop(pos, rot)
                placeChar(char, hrp, pos, rot, freeze)
                RunService.PreSimulation:Wait()
                if ok() and (hrp.Position - pos).Magnitude > 3 then
                    placeChar(char, hrp, pos, rot, freeze)
                end
            end

            pcall(function() hum.BreakJointsOnDeath = false end)
            if cfg.Disguise ~= false then pcall(disguiseOn, char, Vector3.zero) end
            flash(C.Work)

            if waitUntil(startAt) and cfg.Limp ~= false then
                hum.PlatformStand = true
            end

            local last = startVec
            for _, step in ipairs(steps) do
                if type(step) ~= "table" then break end
                if not waitUntil(tonumber(step.At) or 0) then break end
                local dest = (step.To == "start") and startVec or jit(home)
                local rot = rotation()
                if type(step.Glide) == "table" and #step.Glide > 0 then
                    for _, g in ipairs(step.Glide) do
                        if not ok() then break end
                        placeChar(char, hrp, last:Lerp(dest, math.clamp(tonumber(g) or 1, 0, 1)), rot, freeze)
                        RunService.Heartbeat:Wait()
                    end
                else
                    hop(dest, rot)
                end
                last = dest
            end

            waitUntil(releaseAt)
            pcall(function() hum.PlatformStand = oldPlatform end)
            disguiseOff()
            finish()

            if ok() and S.Carrying then
                flash(C.Good, 1.6)
            else
                flash(C.Bad, 1.6)
            end
        end

        local function runDodgeSafe(startedAt)
            if not pcall(runDodge, startedAt) then
                pcall(function()
                    local h = findHum()
                    if h then h.PlatformStand = false end
                end)
                disguiseOff()
                finish()
                flash(C.Bad, 1.6)
            end
        end

        local hitWindow = 25
        local function hitArmed()
            if AG.HitArms <= 0 then return false end
            if hitWindow < os.clock() - (AG.HitArmedAt or 0) then
                AG.HitArms = 0
                return false
            end
            return true
        end

        local function refreshCarry()
            local was = S.Carrying
            S.Carrying = S.SignalCarrying or S.WeldCarrying
            if S.Carrying and not was and alive and AG.Enabled and not S.Active and not hitArmed() then
                S.Active = true
                AG.Busy = true
                AG.BusySince = os.clock()
                task.spawn(runDodgeSafe, os.clock())
            end
        end

        -- sinyal carry dari game
        local carryChanged = type(EggState) == "table" and EggState.CarryChanged or nil
        if type(carryChanged) == "table" and type(carryChanged.Connect) == "function" then
            local okC, conn = pcall(carryChanged.Connect, carryChanged, function(info)
                local carrying = type(info) == "table" and info.IsCarrying == true
                if carrying and info.GuardDisabled == true then carrying = false end
                if carrying and type(info.AreaId) == "string" then S.AreaId = info.AreaId end
                if not carrying then S.AreaId = nil end
                S.SignalCarrying = carrying
                refreshCarry()
            end)
            if okC and conn then ownConns[#ownConns + 1] = conn end
        end

        -- watchdog + deteksi weld egg ke karakter
        local scanAcc = 0
        own(RunService.Heartbeat:Connect(function(dt)
            if AG.Busy or S.Active then
                local cfg = getCfg()
                local limit = math.max(tonumber(cfg.BusyLimit) or LineCfg.BusyLimit, (tonumber(cfg.ReleaseAt) or 0) + 1)
                if os.clock() - AG.BusySince > limit then
                    disguiseOff()
                    local h = findHum()
                    if h and h.PlatformStand then
                        pcall(function() h.PlatformStand = false end)
                    end
                    finish()
                end
            end
            hitArmed()
            scanAcc = scanAcc + dt
            if scanAcc < math.max(LineCfg.WeldScanGap, 0.1) then return end
            scanAcc = 0
            local welded = findCarryModel() ~= nil
            if welded ~= S.WeldCarrying then
                S.WeldCarrying = welded
                refreshCarry()
            end
        end))

        -- cleanup saat Unload
        function AG.Cleanup()
            alive = false
            for _, c in ipairs(ownConns) do
                pcall(function() c:Disconnect() end)
            end
            table.clear(ownConns)
            pcall(disguiseOff)
            finish()
            pcall(function()
                local h = findHum()
                if h and h.PlatformStand then h.PlatformStand = false end
            end)
            pcall(function() gui:Destroy() end)
            AG.Enabled = false
        end

        -- tampilkan panel
        gui.Enabled = AG.PanelShown
        gui.Parent = resolveParent()
        table.insert(HUB.highlights, gui)
        tw(popScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
        render(true)

        -- ===== toggle di menu =====
        AG.UiHandle = GuardMain:AddToggle("Anti Guard (Auto Dodge saat bawa egg)", false, safeCallback(function(v)
            v = v == true
            if AG.Enabled ~= v then
                AG.SetEnabled(v)
                Notify("Anti Guard", v and "Anti Guard ON" or "Anti Guard OFF", v and "Success" or "Error")
            end
        end))

        GuardMain:AddToggle("Anti Guard Panel (OXio)", true, safeCallback(function(v)
            AG.ShowPanel(v == true)
        end))
    end)
    if not okAG then
        pcall(Notify, "Anti Guard", "Gagal memuat: " .. tostring(errAG), "Error", 5)
    end
end
