local function StealSpecificEggRobust(targetItem)
    local record = targetItem.record or targetItem
    if not record or not record.Uid or not record.BoundsCFrame then return false end

    -- Verify the egg is still present in the latest snapshot before traveling
    if EggState and EggState.ReadFieldEggs then
        local ok, snap = pcall(EggState.ReadFieldEggs)
        if ok and snap and snap.Records then
            local stillThere = false
            for _, r in ipairs(snap.Records) do
                if r.Uid == record.Uid and r.State == "Slot" then
                    stillThere = true
                    record = r
                    break
                end
            end
            if not stillThere then
                return false
            end
        end
    end

    local hrp = findHRP()
    local hum = findHum()
    if not hrp then return false end

    EnsureSavedReturnPosition()

    local targetPos = record.BoundsCFrame.Position
    local plotObj = PlotState and PlotState.ResolvePlot and PlotState.ResolvePlot()
    local plotCenter = plotObj and plotObj.CenterPoint and plotObj.CenterPoint.Position or Vector3.new(464.7, 68.2, -364.0)
    local speed = glideSpeed or (hum and hum.WalkSpeed) or 200

    -- Travel to target egg nest
    TravelToDestination(targetPos + Vector3.new(0, 1.2, 0), speed, true)
    
    if hrp then
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 1.2, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.04)

    -- Claim egg via state handler or prompt interaction
    local slotKey = nil
    if record.AreaId and record.NestId then
        slotKey = record.AreaId .. ":" .. record.NestId
    end

    pcall(function()
        if EggState and EggState.CarryFieldEgg then
            EggState.CarryFieldEgg(record.Uid, slotKey)
        end
    end)

    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Name == "CarryAreaEgg" then
            local p = d.Parent
            if p:IsA("Attachment") then p = p.Parent end
            if p and (p.Position - targetPos).Magnitude < 8 then
                pcall(function() fireproximityprompt(d) end)
                break
            end
        end
    end

    local tPickup = os.clock()
    while os.clock() - tPickup < 0.45 and not HUB.dead do
        if isPlayerCarryingEgg() then break end
        task.wait(0.04)
    end

    -- OXio Anti Guard: tunggu rutinitas dodge selesai sebelum balik ke plot
    do
        local AG = HUB.AG
        if AG and AG.Enabled and isPlayerCarryingEgg() then
            local t0 = os.clock()
            while os.clock() - t0 < 0.3 and not AG.Busy and not HUB.dead do
                task.wait(0.03)
            end
            local t1 = os.clock()
            while AG.Busy and not HUB.dead and os.clock() - t1 < 6 do
                task.wait(0.05)
            end
        end
    end

    -- Return to base plot pen
    TravelToDestination(plotCenter, speed, true)
    task.wait(0.12)

    PlantAllCarriedEggsInPen()

    -- Return to saved origin position if set
    if savedReturnCFrame then
        task.wait(0.05)
        TravelToDestination(savedReturnCFrame.Position, speed, true)
        local h = findHRP()
        if h then h.CFrame = savedReturnCFrame end
    end

    local char = LP.Character
    local h = char and char:FindFirstChild("HumanoidRootPart")
    local hu = char and char:FindFirstChildOfClass("Humanoid")
    if h then
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end
    if hu then
        hu.PlatformStand = false
        hu.AutoRotate = true
        pcall(function() hu:ChangeState(Enum.HumanoidStateType.Running) end)
    end

    return carryConfirmed or isPlayerCarryingEgg()
end

