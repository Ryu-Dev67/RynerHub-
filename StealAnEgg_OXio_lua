-- Hub cleanup and unload handler
HUB.Unload = function()
    HUB.dead = true

    for _, c in ipairs(HUB.conns) do
        pcall(function() c:Disconnect() end)
    end
    HUB.conns = {}

    for _, d in ipairs(HUB.drawings) do
        pcall(function() d:Remove() end)
    end
    HUB.drawings = {}

    for _, h in ipairs(HUB.highlights) do
        pcall(function() h:Destroy() end)
    end
    HUB.highlights = {}

    if HUB.AG and HUB.AG.Cleanup then pcall(HUB.AG.Cleanup) end
    stopFly()
    SetFullbright(false)

    local hum = findHum()
    if hum then
        hum.PlatformStand = false
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end

    pcall(function()
        local gui = Window.MainFrame and Window.MainFrame.Parent
        if gui then gui:Destroy() end
    end)

    _G.OXioStealAnEgg = nil
end

Notify("OXio Hub", "Ein Ei stehlen script loaded successfully!", "Success", 3.5)

